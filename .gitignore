# ======================
# ENVIRONMENT VARIABLES
# Never upload these — your API keys and secrets live here
# ======================
.env
.env.local
.env.development
.env.production
.env.staging

# ======================
# NODE / NPM
# These are reinstalled via "npm install" — no need to upload
# ======================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ======================
# BUILD OUTPUT
# Generated automatically when you build — not source code
# ======================
dist/
build/
.next/
out/

# ======================
# DATABASE
# ======================
*.sqlite
*.sqlite3
prisma/generated/

# ======================
# OS JUNK
# Files your computer creates automatically that nobody else needs
# ======================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ======================
# EDITOR FILES
# Your personal editor settings — other devs have their own
# ======================
.vscode/
.idea/
*.swp
*.swo
*.suo

# ======================
# LOGS
# ======================
logs/
*.log

# ======================
# AWS
# Never upload AWS credentials
# ======================
.aws/
*.pem

# ======================
# UPLOADS / MEDIA
# Any files users upload to your app
# ======================
uploads/

Internal Documentation/
claude.md

