{
  "name": "frontrow-backend",
  "version": "0.1.0",
  "description": "Front Row backend — Express API, price tracking, and prediction engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test:seatgeek": "tsx src/tests/test-seatgeek.ts",
    "test:ticketmaster": "tsx src/tests/test-ticketmaster.ts",
    "test:spotify": "tsx src/tests/test-spotify.ts",
    "test:apis": "npm run test:seatgeek && npm run test:ticketmaster && npm run test:spotify",
    "test:genres": "tsx src/tests/test-genres.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "postinstall": "prisma generate",
    "track": "tsx src/scripts/track.ts",
    "bot": "tsx src/bot/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
